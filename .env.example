# =============================================================================
# Example environment configuration for chexlocalize-medical-imaging.
# Copy to `.env` and edit locally. NEVER commit the real `.env`.
#
#   cp .env.example .env
#
# All variables are OPTIONAL — the config loader has sensible defaults and
# auto-detects the project root. Set these only to override defaults, e.g. to
# point at data stored on an external/mounted disk (RunPod volume, etc.).
# =============================================================================

# Development mode: "demo" (small/fast, for debugging) or "full" (real runs).
PROJECT_MODE=demo

# --- Path overrides (leave unset to use in-repo defaults) --------------------
# PROJECT_ROOT=                         # auto-detected if empty
# DATA_ROOT=/mnt/data/chexlocalize
# RAW_DATA_ROOT=/mnt/data/chexlocalize/raw
# PROCESSED_DATA_ROOT=/mnt/data/chexlocalize/processed
# SPLITS_ROOT=data/splits
# RESULTS_ROOT=results
# PREDICTIONS_ROOT=predictions
# CHECKPOINTS_ROOT=checkpoints

# --- Secrets / credentials (NEVER commit real values) ------------------------
# Kept here only as documented placeholders; real values live in `.env`.
# HUGGINGFACE_TOKEN=
# RUNPOD_API_KEY=
# WANDB_API_KEY=
